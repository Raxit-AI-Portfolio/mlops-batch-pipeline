PROFILE=github

MLFLOW_TRACKING_URI=https://dagshub.com/raxitsoni-ai/mlops-batch-pipeline.mlflow

DVC_REMOTE_URL=gs://dvc-remote
# gcsfs reads STORAGE_EMULATOR_HOST to target fake-gcs. DVC's `endpointurl`
# remote option is S3-only and is silently ignored by the gs remote.
STORAGE_EMULATOR_HOST=http://fake-gcs:4443

REGISTRY_URL=http://registry:5000

APP_URL=http://app:8000
