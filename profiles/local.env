PROFILE=local

MLFLOW_TRACKING_URI=http://localhost:5000

DVC_REMOTE_URL=gs://dvc-remote
# gcsfs reads STORAGE_EMULATOR_HOST to target fake-gcs. DVC's `endpointurl`
# remote option is S3-only and is silently ignored by the gs remote.
STORAGE_EMULATOR_HOST=http://localhost:4443

REGISTRY_URL=http://localhost:5001

APP_URL=http://localhost:8000
