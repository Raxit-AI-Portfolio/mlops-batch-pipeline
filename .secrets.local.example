# Copy to .secrets.local and fill in for local act runs.
# Loaded via --secret-file .secrets.local (add to Makefile targets that call act).
# No real secrets needed yet (fake-gcs/mlflow local stack unauthenticated) -- placeholder for later phases (register-deploy.yml, prod GCP).
GITHUB_TOKEN=

# Airflow REST API basic auth (webserver user created by airflow-init in docker-compose.yml).
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
